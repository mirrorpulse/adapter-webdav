{
  "schemaVersion": 1,
  "adapterId": "com.mirrorpulse.adapter.webdav",
  "publisher": "MirrorPulse",
  "version": "0.1.0",
  "protocol": {
    "minimum": 2,
    "maximum": 2
  },
  "entrypoints": {
    "win-x64": "worker/win-x64/MirrorPulse.Adapter.Worker.exe",
    "win-arm64": "worker/win-arm64/MirrorPulse.Adapter.Worker.exe"
  },
  "installPolicy": {
    "maximumInstallations": null
  },
  "instancePolicy": {
    "maximumInstances": null,
    "maximumRootDefinitions": null
  },
  "rootDefinitions": [
    {
      "key": "webdav",
      "label": "WebDAV",
      "directoryName": "WebDAV",
      "customEntry": false
    }
  ],
  "capabilities": {
    "network": true,
    "sourceDirectory": false,
    "remoteChanges": true,
    "rangeRead": true
  },
  "locales": [
    "en-US"
  ],
  "localeMetadata": {
    "en-US": {
      "displayName": "WebDAV",
      "resourcePath": "locales/en-US.json"
    }
  },
  "minimumMirrorPulseVersion": "1.0.0"
}
