<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="adapter-sdk" value="artifacts/sdk-feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="adapter-sdk"><package pattern="MirrorPulse.Adapter.Sdk" /></packageSource>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
  </packageSourceMapping>
</configuration>
